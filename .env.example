# Copy this file to .env and fill in real values. Never commit .env.

# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Your Discord user ID (enable Developer Mode in Discord, then
# right-click your name -> Copy User ID)
ALLOWED_USER_ID=

# The one channel ID the bot will respond in (right-click the
# channel -> Copy Channel ID)
ALLOWED_CHANNEL_ID=

# Folder containing your repos. Defaults to ~/git if unset.
GIT_ROOT=/home/pi/git

# Hours a tmux session can sit idle before it's auto-killed. Defaults to 72.
SESSION_IDLE_TIMEOUT_HOURS=72

# Timeout in seconds for !bash commands run from Discord. Defaults to 60.
BASH_TIMEOUT_SECONDS=60

# Multi-device setup: comma-separated hostnames of all machines sharing this
# channel. Each machine only responds to messages addressed to its hostname.
# Example (three devices named by their hostname):
#   KNOWN_DEVICES=raspberrypi,macbook,macmini
# If unset, the bot responds to all commands without a device prefix.
KNOWN_DEVICES=

# How long (seconds) a device stays active after selection. Defaults to 4 hours.
ACTIVE_DURATION_SECONDS=14400
