# Copy this file to .env and fill in real values. Never commit .env.

# Bot OAuth token (xoxb-…) from your Slack app's "OAuth & Permissions" page
SLACK_BOT_TOKEN=

# App-level token (xapp-…) for Socket Mode — create one under
# "Basic Information" -> "App-Level Tokens" with connections:write scope
SLACK_APP_TOKEN=

# Slack member ID of the only user allowed to control the bot.
# Leave blank to allow anyone in the channel to use it.
# (click your name in Slack -> View Profile -> three-dot menu -> Copy member ID)
SLACK_ALLOWED_USER_ID=

# Slack channel ID the bot will respond in
# (right-click the channel -> View channel details -> copy the ID at the bottom)
SLACK_ALLOWED_CHANNEL_ID=

# Incoming webhook URL for the shared #errors channel.
# Create it in your Slack app under "Incoming Webhooks" → Add New Webhook → #errors.
# The same URL goes in every Pi's .env — errors from all apps land in one place.
# Leave blank to skip error notifications.
SLACK_WEBHOOK_URL=

# Name shown in Slack error messages to identify which app sent them.
# e.g. "claude-open", "mlb-display-large", "mlb-display-grid", "weather"
SLACK_NOTIFY_APP=claude-open

# Folder containing your repos. Defaults to ~/git if unset.
GIT_ROOT=/home/pi/git

# Hours a tmux session can sit idle before it's auto-killed. Defaults to 72.
SESSION_IDLE_TIMEOUT_HOURS=72

# Timeout in seconds for !bash commands. Defaults to 60.
BASH_TIMEOUT_SECONDS=60
